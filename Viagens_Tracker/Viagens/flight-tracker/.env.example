# Copie este arquivo para .env e preencha com seus valores reais.
# O .env é ignorado pelo git (não vai pro repo).

# SerpApi — https://serpapi.com (cadastre e copie a API key do dashboard)
SERPAPI_KEY=

# Travelpayouts — https://www.travelpayouts.com (cadastre, vá em Developers > API)
# Usado apenas na primeira execução de cada rota para gerar baseline estatístico
TRAVELPAYOUTS_TOKEN=

# ntfy.sh — notificações push gratuitas, sem cadastro
# Baixe o app "ntfy" e inscreva-se no tópico que você criou
NTFY_TOPIC=

# Sensibilidade dos alertas (opcional — defaults estão em app/config.py)
# ALERT_PERCENTILE=25
# ALERT_ZSCORE=-1.0
# MIN_SAMPLES_FOR_ALERT=10
# COOLDOWN_HOURS=6
